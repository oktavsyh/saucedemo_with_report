{
  "name": "saucedemo-wdio-cucumber",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "allure:clean": "powershell -Command \"Remove-Item -Recurse -Force reports/allure-results, reports/allure-report -ErrorAction SilentlyContinue\"",
    "allure:generate": "npx allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "npx allure open reports/allure-report"
  },
  "dependencies": {
    "@wdio/allure-reporter": "^8.30.0",
    "@wdio/cli": "^8.30.0",
    "@wdio/cucumber-framework": "^8.30.0",
    "@wdio/local-runner": "^8.30.0",
    "@wdio/spec-reporter": "^8.30.0",
    "chai": "^4.3.10"
  },
  "devDependencies": {
    "allure-commandline": "^2.29.0"
  }
}
